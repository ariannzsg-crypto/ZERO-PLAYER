# ---------------------------------------------------------------------------
# ZERO PLAYER — online music backend (Vercel Edge Functions)
#
# Copy to `.env` for `vercel dev`, or paste each value into
# Vercel → Project → Settings → Environment Variables for deployments.
# Never commit the filled-in file and never ship these values in the APK.
# ---------------------------------------------------------------------------

# Spotify — https://developer.spotify.com/dashboard
# Redirect URI registered on the dashboard must be: zeroplayer://oauth/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SoundCloud — https://developers.soundcloud.com/ (new API applications)
# Redirect URI registered on the dashboard must be the deployed callback:
#   https://<your-project>.vercel.app/api/soundcloud/token
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# YouTube — Google Cloud Console → APIs & Services → enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Optional: comma separated browser origins allowed by CORS. The Android app
# sends no Origin header, so this can stay empty for mobile-only use.
ALLOWED_ORIGINS=
