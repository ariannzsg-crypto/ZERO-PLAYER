<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZeroPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zero_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.ZeroPlayer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zero_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/zero_black</item>
        <item name="postSplashScreenTheme">@style/Theme.ZeroPlayer</item>
    </style>
</resources>
